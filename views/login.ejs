<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập</title>
    <style>
        body { font-family: Arial, sans-serif; background: #f5f5f5; margin: 0; padding: 40px; }
        .container { max-width: 420px; margin: 40px auto; background: white; padding: 30px; border-radius: 8px; }
        h1 { color: rgb(45, 159, 221); text-align: center; }
        label { display: block; margin: 15px 0 5px; font-weight: bold; }
        input { width: 100%; box-sizing: border-box; padding: 10px; border: 1px solid #ccc; border-radius: 5px; }
        button { width: 100%; margin-top: 24px; padding: 11px; border: 0; border-radius: 5px; background: #447bcd; color: white; cursor: pointer; }
        .error { padding: 10px; border-radius: 5px; background: #f8d7da; color: #842029; }
        .hint { color: #555; font-size: 13px; }
    </style>
</head>
<body>
<main class="container">
    <h1>Đăng nhập</h1>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form action="/login" method="POST">
        <label for="username">Username</label>
        <input id="username" name="username" type="text" minlength="7" pattern="[A-Za-z0-9]{7,}"
            title="Từ 7 ký tự, chỉ gồm chữ cái không dấu và chữ số." autocomplete="username" required>
        <p class="hint">Ít nhất 7 ký tự; chỉ gồm chữ cái không dấu và chữ số.</p>

        <label for="password">Password</label>
        <input id="password" name="password" type="password" minlength="8"
            pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*[0-9]).{8,}"
            title="Ít nhất 8 ký tự, gồm chữ thường, chữ hoa và chữ số."
            autocomplete="current-password" required>
        <p class="hint">Ít nhất 8 ký tự, gồm chữ thường, chữ hoa và chữ số.</p>

        <button type="submit">Đăng nhập</button>
    </form>
</main>
</body>
</html>
